  m_TableData:
  - m_Id: 1090132115456
    m_Localized: "n\xE0y..."
    m_Metadata:
      m_Items: []
  - m_Id: 1145924747264
    m_Localized: "nh\u1EDB nh\xE0 h\u1EA3 ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2459920498688
    m_Localized: "\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 2657258307584
    m_Localized: "Kh\xF4ng bi\u1EBFt U \u1EDF nh\xE0"
    m_Metadata:
      m_Items: []
  - m_Id: 2878923079680
    m_Localized: "c\xF3 m\u1EA1nh kh\u1ECFe kh\xF4ng n\u1EEFa"
    m_Metadata:
      m_Items: []
  - m_Id: 8144330131767296
    m_Localized: "M\u1ECDi ng\u01B0\u1EDDi \u01A1iii"
    m_Metadata:
      m_Items: []
  - m_Id: 8144372737507328
    m_Localized: "c\xF3 c\u01A1m n\xE8"
    m_Metadata:
      m_Items: []
  - m_Id: 8144386729705472
    m_Localized: "m\u1EDBi l\u1EA5y t\u1EEB s\xF4ng Th\u1EA1ch H\xE3n qua \u0111\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 8144412667281408
    m_Localized: "Cu\u1ED1i c\xF9ng c\u0169ng \u0111\u01B0\u1EE3c \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 8144424818180096
    m_Localized: "\u0102n c\u01A1m \u0111\u1ED3ng ch\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 8148263583612928
    m_Localized: "\u0110\u1ED3ng ch\xED v\u1EA5t v\u1EA3 r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 8148397071532032
    m_Localized: "c\u1EE9 ngh\u1EC9 ng\u01A1i \u1EDF \u0111\xE2y \u0110\u1EC3 t\xF4i
      \u0111i chia cho nh\u1EEFng ng\u01B0\u1EDDi kh\xE1c cho"
    m_Metadata:
      m_Items: []
  - m_Id: 8148571055456256
    m_Localized: "V\u1EADy nh\u1EDD c\u1EADu nh\xE9... t\xF4i ng\u1ED3i th\u1EDF
      m\u1ED9t l\xE1t \u0111\xE3"
    m_Metadata:
      m_Items: []
  - m_Id: 8186587102838784
    m_Localized: "\u0102n c\u01A1m \u0111\u1ED3ng ch\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 8186625958871040
    m_Localized: "\u0110\u1ED2NG CH\xCD! \u0110\u1ED2NG CH\xCD!"
    m_Metadata:
      m_Items: []
  - m_Id: 8186641863671808
    m_Localized: "C\xF3 c\u01A1m h\u1EA3 ? Cho xin m\u1ED9t v\u1EAFt v\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 8186652735307776
    m_Localized: "T\u1EEB t\u1EEB, t\xF4i qua \u0111\xF3 li\u1EC1n"
    m_Metadata:
      m_Items: []
  - m_Id: 8187705438502912
    m_Localized: "PH\xC1O K\xCDCH C\u1EE6A \u0110\u1ECACH, CH\u1EA0Y V\u1EC0 H\u1EA6M
      NHANH !"
    m_Metadata:
      m_Items: []
  - m_Id: 9255412959281152
    m_Localized: "NHANH L\xCAN"
    m_Metadata:
      m_Items: []
  - m_Id: 9255455799902208
    m_Localized: "C\u1EE8U TH\u01AF\u01A0NG"
    m_Metadata:
      m_Items: []
  - m_Id: 9255469150371840
    m_Localized: "May qu\xE1 ch\u1EC9 b\u1ECB th\u01B0\u01A1ng nh\u1EB9 th\xF4i"
    m_Metadata:
      m_Items: []
  - m_Id: 9255480462409728
    m_Localized: "kh\xF4ng ch\u1EBFt \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 9255490260303872
    m_Localized: "Th\u1EB1ng Nam \u0111\xE2u \u0111\u01B0a anh kh\u1EA9u AK"
    m_Metadata:
      m_Items: []
  - m_Id: 9256520280702976
    m_Localized: "d\u1EA1 \u0111\xE2y anh"
    m_Metadata:
      m_Items: []
  - m_Id: 9256541046702080
    m_Localized: "c\u1EA7m l\u1EA5y"
    m_Metadata:
      m_Items: []
  - m_Id: 9256553700917248
    m_Localized: "C\xF2n \u0111i \u0111\u01B0\u1EE3c th\xEC ra v\u1ECB tr\xED chi\u1EBFn
      \u0111\u1EA5u nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 13648195916660736
    m_Localized: "C\xFAt ra kh\u1ECFi \u0111\xE2y B\u1ECDn ng\u1EE5y qu\xE2n"
    m_Metadata:
      m_Items: []
  - m_Id: 13648269530890240
    m_Localized: "Tam \u0111\u1EA3o c\xF2n, th\xE0nh c\u1ED5 qu\u1EA3ng tr\u1ECB
      c\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 13648284198371328
    m_Localized: "Tam \u0111\u1EA3o c\xF2n, th\xE0nh c\u1ED5 qu\u1EA3ng tr\u1ECB
      c\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 13648298085711872
    m_Localized: "Tam \u0111\u1EA3o c\xF2n, th\xE0nh c\u1ED5 qu\u1EA3ng tr\u1ECB
      c\xF2n"
    m_Metadata:
      m_Items: []
  - m_Id: 13648308047183872
    m_Localized: Control, target acquired. Standby for release... Three, two, one.
      Bombs away
    m_Metadata:
      m_Items: []
  - m_Id: 13649197034110976
    m_Localized: "T\u1EA4T C\u1EA2 CH\u1EA0Y V\u1EC0 H\u1EA6M TR\xDA \u1EA8N NHANH
      !"
    m_Metadata:
      m_Items: []
