  m_TableData:
  - m_Id: 1090132115456
    m_Localized: Ei...
    m_Metadata:
      m_Items: []
  - m_Id: 1145924747264
    m_Localized: Saudade de casa ?
    m_Metadata:
      m_Items: []
  - m_Id: 2459920498688
    m_Localized: "\xC9..."
    m_Metadata:
      m_Items: []
  - m_Id: 2657258307584
    m_Localized: "Fico pensando se a minha m\xE3e l\xE1 em casa..."
    m_Metadata:
      m_Items: []
  - m_Id: 2878923079680
    m_Localized: "...est\xE1 bem."
    m_Metadata:
      m_Items: []
  - m_Id: 8144330131767296
    m_Localized: Camaradas
    m_Metadata:
      m_Items: []
  - m_Id: 8144372737507328
    m_Localized: Temos arroz
    m_Metadata:
      m_Items: []
  - m_Id: 8144386729705472
    m_Localized: Acabamos de trazer pelo rio Thach Han
    m_Metadata:
      m_Items: []
  - m_Id: 8144412667281408
    m_Localized: Ufa... Finalmente vamos comer
    m_Metadata:
      m_Items: []
  - m_Id: 8144424818180096
    m_Localized: Coma um pouco de arroz, camarada
    m_Metadata:
      m_Items: []
  - m_Id: 8148263583612928
    m_Localized: "Voc\xEA trabalhou duro, camarada"
    m_Metadata:
      m_Items: []
  - m_Id: 8148397071532032
    m_Localized: Descanse aqui. Deixe que eu distribuo para os outros
    m_Metadata:
      m_Items: []
  - m_Id: 8148571055456256
    m_Localized: "Vou deixar com voc\xEA ent\xE3o... Preciso sentar e recuperar o
      f\xF4lego"
    m_Metadata:
      m_Items: []
  - m_Id: 8186587102838784
    m_Localized: Aqui, coma um pouco de arroz, camarada
    m_Metadata:
      m_Items: []
  - m_Id: 8186625958871040
    m_Localized: CAMARADA! CAMARADA!
    m_Metadata:
      m_Items: []
  - m_Id: 8186641863671808
    m_Localized: "Tem arroz a\xED ? Me d\xE1 um pouco"
    m_Metadata:
      m_Items: []
  - m_Id: 8186652735307776
    m_Localized: "Calma, j\xE1 estou indo"
    m_Metadata:
      m_Items: []
  - m_Id: 8187705438502912
    m_Localized: "ARTILHARIA INIMIGA! PRO B\xDANKER, R\xC1PIDO !"
    m_Metadata:
      m_Items: []
  - m_Id: 9255412959281152
    m_Localized: "VAI, R\xC1PIDO"
    m_Metadata:
      m_Items: []
  - m_Id: 9255455799902208
    m_Localized: "M\xC9DICO"
    m_Metadata:
      m_Items: []
  - m_Id: 9255469150371840
    m_Localized: "Sorte sua, \xE9 s\xF3 um arranh\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 9255480462409728
    m_Localized: "Voc\xEA n\xE3o vai morrer hoje"
    m_Metadata:
      m_Items: []
  - m_Id: 9255490260303872
    m_Localized: "Cad\xEA o Nam? Me passa essa AK"
    m_Metadata:
      m_Items: []
  - m_Id: 9256520280702976
    m_Localized: Aqui, chefe
    m_Metadata:
      m_Items: []
  - m_Id: 9256541046702080
    m_Localized: pega
    m_Metadata:
      m_Items: []
  - m_Id: 9256553700917248
    m_Localized: "Se ainda consegue andar, volte para a posi\xE7\xE3o de combate.
      R\xE1pido"
    m_Metadata:
      m_Items: []
  references:
