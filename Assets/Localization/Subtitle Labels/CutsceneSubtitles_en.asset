  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: CutsceneSubtitles_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 64b69f49f69c2bb41ad81d4d7469d2b9, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1090132115456
    m_Localized: Hey...
    m_Metadata:
      m_Items: []
  - m_Id: 1145924747264
    m_Localized: Homesick ?
    m_Metadata:
      m_Items: []
  - m_Id: 2459920498688
    m_Localized: Yeah...
    m_Metadata:
      m_Items: []
  - m_Id: 2657258307584
    m_Localized: I wonder if my ma back home...
    m_Metadata:
      m_Items: []
  - m_Id: 2878923079680
    m_Localized: ..is doing alright.
    m_Metadata:
      m_Items: []
  - m_Id: 8144330131767296
    m_Localized: Hey everyone
    m_Metadata:
      m_Items: []
  - m_Id: 8144372737507328
    m_Localized: We've got rice
    m_Metadata:
      m_Items: []
  - m_Id: 8144386729705472
    m_Localized: Just brought it across the Thach Han river
    m_Metadata:
      m_Items: []
  - m_Id: 8144412667281408
    m_Localized: Phew... Finally getting to eat
    m_Metadata:
      m_Items: []
  - m_Id: 8144424818180096
    m_Localized: Have some rice, comrade
    m_Metadata:
      m_Items: []
  - m_Id: 8148263583612928
    m_Localized: You've worked hard, comrade
    m_Metadata:
      m_Items: []
  - m_Id: 8148397071532032
    m_Localized: Just rest here. Let me go distribute it to the others
    m_Metadata:
      m_Items: []
  - m_Id: 8148571055456256
    m_Localized: I'll leave it to you then... I need to sit and catch my breath
    m_Metadata:
      m_Items: []
  - m_Id: 8186587102838784
    m_Localized: Here, have some rice, comrade
    m_Metadata:
      m_Items: []
  - m_Id: 8186625958871040
    m_Localized: COMRADE! COMRADE!
    m_Metadata:
      m_Items: []
  - m_Id: 8186641863671808
    m_Localized: You got rice ? Let me have some
    m_Metadata:
      m_Items: []
  - m_Id: 8186652735307776
    m_Localized: Hold on, I'll be right there
    m_Metadata:
      m_Items: []
  - m_Id: 8187705438502912
    m_Localized: ENEMY ARTILLERY! GET TO THE BUNKER, QUICK !
    m_Metadata:
      m_Items: []
  - m_Id: 9255412959281152
    m_Localized: MOVE IT
    m_Metadata:
      m_Items: []
  - m_Id: 9255455799902208
    m_Localized: MEDIC
    m_Metadata:
      m_Items: []
  - m_Id: 9255469150371840
    m_Localized: You're lucky, it's just a scratch
    m_Metadata:
      m_Items: []
  - m_Id: 9255480462409728
    m_Localized: You're not dying today
    m_Metadata:
      m_Items: []
  - m_Id: 9255490260303872
    m_Localized: Where's Nam? Hand me that AK
    m_Metadata:
      m_Items: []
  - m_Id: 9256520280702976
    m_Localized: Right here, sir
    m_Metadata:
      m_Items: []
  - m_Id: 9256541046702080
    m_Localized: take it
    m_Metadata:
      m_Items: []
  - m_Id: 9256553700917248
    m_Localized: If you can walk, get back on the line. Now
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
