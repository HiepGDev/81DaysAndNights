  m_TableData:
  - m_Id: 1090132115456
    m_Localized: "\u042D\u0439..."
    m_Metadata:
      m_Items: []
  - m_Id: 1145924747264
    m_Localized: "\u041F\u043E \u0434\u043E\u043C\u0443 \u0441\u043A\u0443\u0447\u0430\u0435\u0448\u044C
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 2459920498688
    m_Localized: "\u0414\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2657258307584
    m_Localized: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E, \u043A\u0430\u043A
      \u0442\u0430\u043C \u043C\u0430\u043C\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2878923079680
    m_Localized: "...\u0432\u0441\u0435 \u043B\u0438 \u0441 \u043D\u0435\u0439 \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 8144330131767296
    m_Localized: "\u0422\u043E\u0432\u0430\u0440\u0438\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 8144372737507328
    m_Localized: "\u0423 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C \u0440\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 8144386729705472
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u043A\u0443 \u0422\u0445\u0430\u043A\u0445\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 8144412667281408
    m_Localized: "\u0424\u0443\u0445... \u041D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
      \u043F\u043E\u0435\u0434\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 8144424818180096
    m_Localized: "\u041F\u043E\u0435\u0448\u044C \u0440\u0438\u0441\u0430, \u0442\u043E\u0432\u0430\u0440\u0438\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 8148263583612928
    m_Localized: "\u0422\u044B \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u0442\u0440\u0443\u0434\u0438\u043B\u0441\u044F,
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 8148397071532032
    m_Localized: "\u041E\u0442\u0434\u043E\u0445\u043D\u0438 \u0437\u0434\u0435\u0441\u044C.
      \u0414\u0430\u0432\u0430\u0439 \u044F \u0440\u0430\u0437\u0434\u0430\u043C
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 8148571055456256
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E
      \u044D\u0442\u043E \u043D\u0430 \u0442\u0435\u0431\u044F... \u041C\u043D\u0435
      \u043D\u0443\u0436\u043D\u043E \u0441\u0435\u0441\u0442\u044C \u0438 \u043E\u0442\u0434\u044B\u0448\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 8186587102838784
    m_Localized: "\u0414\u0435\u0440\u0436\u0438 \u0440\u0438\u0441, \u0442\u043E\u0432\u0430\u0440\u0438\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 8186625958871040
    m_Localized: "\u0422\u041E\u0412\u0410\u0420\u0418\u0429! \u0422\u041E\u0412\u0410\u0420\u0418\u0429!"
    m_Metadata:
      m_Items: []
  - m_Id: 8186641863671808
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0440\u0438\u0441
      ? \u0414\u0430\u0439\u0442\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 8186652735307776
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438, \u0441\u0435\u0439\u0447\u0430\u0441
      \u043F\u043E\u0434\u043E\u0439\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 8187705438502912
    m_Localized: "\u0412\u0420\u0410\u0416\u0415\u0421\u041A\u0410\u042F \u0410\u0420\u0422\u0418\u041B\u041B\u0415\u0420\u0418\u042F!
      \u0411\u042B\u0421\u0422\u0420\u041E \u0412 \u0423\u041A\u0420\u042B\u0422\u0418\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 9255412959281152
    m_Localized: "\u0411\u042B\u0421\u0422\u0420\u0415\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 9255455799902208
    m_Localized: "\u0421\u0410\u041D\u0418\u0422\u0410\u0420"
    m_Metadata:
      m_Items: []
  - m_Id: 9255469150371840
    m_Localized: "\u041F\u043E\u0432\u0435\u0437\u043B\u043E, \u0432\u0441\u0435\u0433\u043E
      \u043B\u0438\u0448\u044C \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 9255480462409728
    m_Localized: "\u0416\u0438\u0442\u044C \u0431\u0443\u0434\u0435\u0448\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 9255490260303872
    m_Localized: "\u0413\u0434\u0435 \u041D\u0430\u043C? \u0414\u0430\u0439 \u0441\u044E\u0434\u0430
      \u0410\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 9256520280702976
    m_Localized: "\u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 9256541046702080
    m_Localized: "\u0431\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 9256553700917248
    m_Localized: "\u0415\u0441\u043B\u0438 \u043C\u043E\u0436\u0435\u0448\u044C \u0445\u043E\u0434\u0438\u0442\u044C,
      \u0436\u0438\u0432\u043E \u043D\u0430 \u043F\u043E\u0437\u0438\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 13648195916660736
    m_Localized: "\u0411\u0435\u0433\u0438\u0442\u0435, \u0443\u0431\u043B\u044E\u0434\u043A\u0438!
      \u041F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u0439\u0442\u0435 \u043E\u0442\u0441\u044E\u0434\u0430
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 13648269530890240
    m_Localized: "\u041F\u043E\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0422\u0430\u043C
      \u0414\u0430\u043E, \u0441\u0442\u043E\u0438\u0442 \u0438 \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u044C
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 13648284198371328
    m_Localized: "\u041F\u043E\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0422\u0430\u043C
      \u0414\u0430\u043E, \u0441\u0442\u043E\u0438\u0442 \u0438 \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u044C
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 13648298085711872
    m_Localized: "\u041F\u043E\u043A\u0430 \u0441\u0442\u043E\u0438\u0442 \u0422\u0430\u043C
      \u0414\u0430\u043E, \u0441\u0442\u043E\u0438\u0442 \u0438 \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u044C
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 13648308047183872
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C, \u0446\u0435\u043B\u044C
      \u0437\u0430\u0445\u0432\u0430\u0447\u0435\u043D\u0430. \u0413\u043E\u0442\u043E\u0432
      \u043A \u0441\u0431\u0440\u043E\u0441\u0443... \u0422\u0440\u0438, \u0434\u0432\u0430,
      \u043E\u0434\u0438\u043D. \u0411\u043E\u043C\u0431\u044B \u043F\u043E\u0448\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 13649197034110976
    m_Localized: "\u0412\u0421\u0415 \u0412 \u0411\u0423\u041D\u041A\u0415\u0420,
      \u0416\u0418\u0412\u041E !"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
