  - m_Id: 3676674049703936
    m_Localized: "\u0414\u0430\u0442\u044C \u0440\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 3970655216205824
    m_Localized: "81 Days and Nights \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0432\u044B\u043C\u044B\u0441\u0435\u043B.\n\n\u0425\u043E\u0442\u044F \u043C\u0435\u0441\u0442\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u0435\u043D\u043E
      \u0431\u0438\u0442\u0432\u043E\u0439 \u043F\u0440\u0438 \u041A\u0443\u0430\u043D\u0433\u0447\u0438
      1972 \u0433\u043E\u0434\u0430 \u0432\u043E \u0412\u044C\u0435\u0442\u043D\u0430\u043C\u0435,\n\u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0438, \u043B\u043E\u043A\u0430\u0446\u0438\u0438
      \u0438 \u0441\u043E\u0431\u044B\u0442\u0438\u044F \u0431\u044B\u043B\u0438
      \u0432\u044B\u043C\u044B\u0448\u043B\u0435\u043D\u044B \u0440\u0430\u0434\u0438
      \u0438\u0433\u0440\u043E\u0432\u043E\u0433\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430
      \u0438 \u0434\u0440\u0430\u043C\u0430\u0442\u0438\u0437\u043C\u0430.\n\n\u0414\u0430\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0435\u043A\u0442 \u0441\u043E\u0437\u0434\u0430\u043D \u0432
      \u043F\u0430\u043C\u044F\u0442\u043D\u044B\u0445 \u0438 \u0440\u0430\u0437\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445\n\u0446\u0435\u043B\u044F\u0445
      \u0438 \u043D\u0435 \u043F\u0440\u0435\u0442\u0435\u043D\u0434\u0443\u0435\u0442
      \u043D\u0430 100% \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C."
