    m_Localized: "nh\u1EB7t \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 6514348654592
    m_Localized: "Nh\u1EA5n {0} \u0111\u1EC3 {1}"
    m_Metadata:
      m_Items:
      - rid: 8959167304910241910
  - m_Id: 3676674049703936
    m_Localized: "\u0110\u01B0a c\u01A1m"
    m_Metadata:
      m_Items: []
  - m_Id: 3970655216205824
    m_Localized: "81 Ng\xE0y v\xE0 \u0110\xEAm l\xE0 m\u1ED9t t\xE1c ph\u1EA9m h\u01B0
      c\u1EA5u l\u1ECBch s\u1EED.\n\nM\u1EB7c d\xF9 b\u1ED1i c\u1EA3nh \u0111\u01B0\u1EE3c
      l\u1EA5y c\u1EA3m h\u1EE9ng t\u1EEB Tr\u1EADn Th\xE0nh c\u1ED5 Qu\u1EA3ng Tr\u1ECB
      n\u0103m 1972 t\u1EA1i Vi\u1EC7t Nam,\n m\u1ED9t s\u1ED1 nh\xE2n v\u1EADt,
      \u0111\u1ECBa \u0111i\u1EC3m v\xE0 s\u1EF1 ki\u1EC7n \u0111\xE3 \u0111\u01B0\u1EE3c
      h\u01B0 c\u1EA5u nh\u1EB1m ph\u1EE5c v\u1EE5 cho m\u1EE5c \u0111\xEDch gameplay
      v\xE0 k\u1ECBch t\xEDnh h\xF3a.\n\nTr\u1EA3i nghi\u1EC7m n\xE0y \u0111\u01B0\u1EE3c
      t\u1EA1o ra nh\u1EB1m m\u1EE5c \u0111\xEDch t\u01B0\u1EDFng ni\u1EC7m v\xE0
      gi\u1EA3i tr\xED,\n\u0111\u1ED3ng th\u1EDDi kh\xF4ng kh\u1EB3ng \u0111\u1ECBnh
      \u0111\u1EA3m b\u1EA3o \u0111\u1ED9 ch\xEDnh x\xE1c l\u1ECBch s\u1EED 100%."
    m_Metadata:
      m_Items: []
