  - m_Id: 2812110986805248
    m_Localized: "\u041F\u0440\u0438\u0446\u0435\u043B\u0438\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2812175784607744
    m_Localized: "\u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2821561290588160
    m_Localized: "\u041F\u0430\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2821714294603776
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2821832842412032
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 27151138091433984
    m_Localized: "\u041E\u0433\u043D\u0435\u0432\u0430\u044F \u043C\u043E\u0449\u044C,
      \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0448\u0430\u044F\u0441\u044F \u043D\u0430
      \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u044C, \u0440\u0430\u0432\u043D\u044F\u043B\u0430\u0441\u044C
      \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0441\u0438\u043B\u0435 \u0441\u0435\u043C\u0438 \u0430\u0442\u043E\u043C\u043D\u044B\u0445
      \u0431\u043E\u043C\u0431 \u0425\u0438\u0440\u043E\u0441\u0438\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 27151268551065600
    m_Localized: "\u041C\u043D\u043E\u0433\u0438\u043C\u0438 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u0430\u043C\u0438
      \u0431\u044B\u043B\u0438 \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u044B \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u043E\u0432
      \u0425\u0430\u043D\u043E\u044F, \u043E\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0438\u0435
      \u0443\u0447\u0435\u0431\u0443, \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u0432 \u0431\u043E\u0439 \u0432 1971 \u0433\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 27151287404462080
    m_Localized: "\u0420\u0435\u043A\u0430 \u0422\u0445\u0430\u0442\u044C\u0445\u0430\u043D
      \u0431\u044B\u043B\u0430 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043B\u0438\u043D\u0438\u0435\u0439 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u044F.
      \u041F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0442\u044C \u0435\u0451 \u043D\u043E\u0447\u044C\u044E
      \u043F\u043E\u0434 \u0441\u0432\u0435\u0442\u043E\u043C \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u0440\u0430\u043A\u0435\u0442 \u0431\u044B\u043B\u043E \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 27151299718938624
    m_Localized: "\u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0440\u0430\u0437\u043C\u0435\u0440
      \u0432\u0441\u0435\u0433\u043E 500\u0445500 \u043C\u0435\u0442\u0440\u043E\u0432,
      \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u044C \u0441\u0442\u0430\u043B\u0430
      \u0441\u0430\u043C\u044B\u043C \u043A\u0440\u043E\u0432\u0430\u0432\u044B\u043C
      \u044D\u043F\u0438\u0446\u0435\u043D\u0442\u0440\u043E\u043C \u043D\u0430\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
      1972 \u0433\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 27151317335015424
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u044B\u0435 \u043B\u0435\u0442\u043D\u0438\u0435
      \u043C\u0443\u0441\u0441\u043E\u043D\u043D\u044B\u0435 \u0434\u043E\u0436\u0434\u0438
      \u0437\u0430\u0442\u043E\u043F\u0438\u043B\u0438 \u0442\u0440\u0430\u043D\u0448\u0435\u0438,
      \u0432\u044B\u0437\u0432\u0430\u0432 \u0442\u044F\u0436\u0435\u043B\u0443\u044E
      \u0442\u0440\u0430\u043D\u0448\u0435\u0439\u043D\u0443\u044E \u0441\u0442\u043E\u043F\u0443
      \u0438 \u0431\u043E\u043B\u0435\u0437\u043D\u0438 \u0441\u0440\u0435\u0434\u0438
      \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 27151329687240704
    m_Localized: "\u0412 \u0440\u0430\u0437\u0433\u0430\u0440 \u0431\u0438\u0442\u0432\u044B
      \u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044E
      \u0426\u0438\u0442\u0430\u0434\u0435\u043B\u0438 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E
      \u043F\u0430\u0434\u0430\u043B\u043E \u0434\u043E 20 000 \u0430\u0440\u0442\u0438\u043B\u043B\u0435\u0440\u0438\u0439\u0441\u043A\u0438\u0445
      \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 27151341800390656
    m_Localized: "\u041B\u0438\u043D\u0438\u0438 \u0441\u0432\u044F\u0437\u0438 \u0447\u0430\u0441\u0442\u043E
      \u043E\u0431\u0440\u044B\u0432\u0430\u043B\u0438\u0441\u044C \u0431\u043E\u043C\u0431\u0430\u0440\u0434\u0438\u0440\u043E\u0432\u043A\u0430\u043C\u0438,
      \u0438\u0437-\u0437\u0430 \u0447\u0435\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u043E\u0441\u044C \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B \u043F\u0435\u0448\u043A\u043E\u043C
      \u043F\u043E\u0434 \u0448\u043A\u0432\u0430\u043B\u044C\u043D\u044B\u043C \u043E\u0433\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 27151352869158912
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0441\u0442\u0435\u043D\u044B \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u0432 \u043F\u044B\u043B\u044C, \u0441\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0447\u0430\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432 \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0435 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u044B\u0435
      \u0441\u0445\u0432\u0430\u0442\u043A\u0438 \u0441\u0440\u0435\u0434\u0438 \u0440\u0443\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 27152720317120512
    m_Localized: "\u0417\u043D\u0430\u0435\u0442\u0435 \u043B\u0438 \u0432\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 27152879801335808
