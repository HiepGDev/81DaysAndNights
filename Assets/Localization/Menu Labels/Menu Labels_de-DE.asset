  - m_Id: 2812175784607744
    m_Localized: Nachladen
    m_Metadata:
      m_Items: []
  - m_Id: 2821561290588160
    m_Localized: Spiel pausiert
    m_Metadata:
      m_Items: []
  - m_Id: 2821714294603776
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 2821832842412032
    m_Localized: "Zur\xFCck zum Hauptmen\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 27151138091433984
    m_Localized: "Die Feuerkraft, die auf die Zitadelle niederging, entsprach der
      Zerst\xF6rungskraft von sieben Hiroshima-Atombomben."
    m_Metadata:
      m_Items: []
  - m_Id: 27151268551065600
    m_Localized: "Viele Verteidiger waren Universit\xE4tsstudenten aus Hanoi, die
      1971 ihr Studium abbrachen, um in den Kampf zu ziehen."
    m_Metadata:
      m_Items: []
  - m_Id: 27151287404462080
    m_Localized: "Der Thach-Han-Fluss war die einzige Versorgungsroute. Ihn nachts
      im Licht feindlicher Leuchtraketen zu \xFCberqueren, war ein t\xF6dliches Unterfangen."
    m_Metadata:
      m_Items: []
  - m_Id: 27151299718938624
    m_Localized: "Obwohl sie nur 500x500 Meter gro\xDF war, wurde die Zitadelle zum
      blutigsten Brennpunkt der Offensive von 1972."
    m_Metadata:
      m_Items: []
  - m_Id: 27151317335015424
    m_Localized: "Schwere Sommermonsunregenf\xE4lle \xFCberfluteten die Sch\xFCtzengr\xE4ben
      und verursachten schwere Grabenf\xFC\xDFe und Krankheiten unter den Verteidigern."
    m_Metadata:
      m_Items: []
  - m_Id: 27151329687240704
    m_Localized: "Auf dem H\xF6hepunkt der Schlacht fielen t\xE4glich bis zu 20.000
      Artilleriegeschosse auf das kleine Gebiet der Zitadelle."
    m_Metadata:
      m_Items: []
  - m_Id: 27151341800390656
    m_Localized: "Kommunikationskabel wurden durch Bombardements h\xE4ufig durchtrennt,
      was die Soldaten zwang, Befehle zu Fu\xDF durch schweres Feuer zu \xFCberbringen."
    m_Metadata:
      m_Items: []
  - m_Id: 27151352869158912
    m_Localized: "Als die Mauern zu Staub zerfielen, artete der Kampf oft in brutale
      Nahk\xE4mpfe inmitten der Tr\xFCmmer aus."
    m_Metadata:
      m_Items: []
  - m_Id: 27152720317120512
    m_Localized: Wusstest du schon?
    m_Metadata:
      m_Items: []
  - m_Id: 27152879801335808
    m_Localized: Betrete das Schlachtfeld
    m_Metadata:
      m_Items: []
  - m_Id: 27153264578396160
    m_Localized: Klicken, um fortzufahren
    m_Metadata:
      m_Items: []
  - m_Id: 30409331575881728
