  m_TableData:
  - m_Id: 8433696768
    m_Localized: "Ch\u01A1i m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 10887364608
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 13978566656
    m_Localized: "Ch\u1ECDn nhi\u1EC7m v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 16927162368
    m_Localized: "Tho\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 1751399103725568
    m_Localized: Video
    m_Metadata:
      m_Items: []
  - m_Id: 1755940540907520
    m_Localized: "\u0110\u1ED3 h\u1ECDa"
    m_Metadata:
      m_Items: []
  - m_Id: 1756543535022080
    m_Localized: "\xC2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 1756784732667904
    m_Localized: "\u0110i\u1EC1u khi\u1EC3n"
    m_Metadata:
      m_Items: []
  - m_Id: 1775860536311808
    m_Localized: "\u0110\u1ED9 ph\xE2n gi\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 1776103499759616
    m_Localized: "Ch\u1EBF \u0111\u1ED9 m\xE0n h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 1776636662906880
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 2092014748303360
    m_Localized: "\u0110\u1ED9 s\xE1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2448684498288640
    m_Localized: "G\xF3c nh\xECn"
    m_Metadata:
      m_Items: []
  - m_Id: 2450380515442688
    m_Localized: "T\u1EF7 l\u1EC7 hi\u1EC3n th\u1ECB"
    m_Metadata:
      m_Items: []
  - m_Id: 2450542084227072
    m_Localized: "Ch\u1EA5t l\u01B0\u1EE3ng b\xF3ng \u0111\u1ED5"
    m_Metadata:
      m_Items: []
  - m_Id: 2450709764112384
    m_Localized: "Kh\u1EED r\u0103ng c\u01B0a"
    m_Metadata:
      m_Items: []
  - m_Id: 2451265974960128
    m_Localized: "Gi\u1EDBi h\u1EA1n khung h\xECnh"
    m_Metadata:
      m_Items: []
  - m_Id: 2804112168058880
    m_Localized: "\u0110\u1ED5 b\xF3ng m\xF4i tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 2805022013259776
    m_Localized: "\xC2m l\u01B0\u1EE3ng t\u1ED5ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2805096512487424
    m_Localized: "\xC2m l\u01B0\u1EE3ng nh\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 2805124559798272
    m_Localized: "\xC2m l\u01B0\u1EE3ng hi\u1EC7u \u1EE9ng"
    m_Metadata:
      m_Items: []
  - m_Id: 2808698203275264
    m_Localized: "\u0110\u1ED9 nh\u1EA1y camera"
    m_Metadata:
      m_Items: []
  - m_Id: 2809134293450752
    m_Localized: "G\xE1n ph\xEDm"
    m_Metadata:
      m_Items: []
  - m_Id: 2809270058876928
    m_Localized: "Di chuy\u1EC3n l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 2809473570701312
    m_Localized: "Di chuy\u1EC3n l\xF9i"
    m_Metadata:
      m_Items: []
  - m_Id: 2809614566424576
    m_Localized: "Di chuy\u1EC3n tr\xE1i"
    m_Metadata:
      m_Items: []
  - m_Id: 2810319335325696
    m_Localized: "Di chuy\u1EC3n ph\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 2810792498954240
    m_Localized: "Nh\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 2810824912535552
    m_Localized: "Ch\u1EA1y nhanh"
    m_Metadata:
      m_Items: []
  - m_Id: 2810846152491008
    m_Localized: "C\xFAi ng\u01B0\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 2810937017892864
    m_Localized: "B\u1EAFn"
    m_Metadata:
      m_Items: []
  - m_Id: 2812110986805248
    m_Localized: "Ng\u1EAFm"
    m_Metadata:
      m_Items: []
  - m_Id: 2812175784607744
    m_Localized: "N\u1EA1p \u0111\u1EA1n"
    m_Metadata:
      m_Items: []
  - m_Id: 2821561290588160
    m_Localized: "\u0110\xE3 t\u1EA1m d\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 2821714294603776
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 2821832842412032
    m_Localized: "Tho\xE1t ra menu ch\xEDnh"
    m_Metadata:
      m_Items: []
  - m_Id: 27151138091433984
    m_Localized: "L\u01B0\u1EE3ng bom \u0111\u1EA1n tr\xFAt xu\u1ED1ng Th\xE0nh c\u1ED5
      t\u01B0\u01A1ng \u0111\u01B0\u01A1ng s\u1EE9c c\xF4ng ph\xE1 c\u1EE7a 7 qu\u1EA3
      bom nguy\xEAn t\u1EED n\xE9m xu\u1ED1ng Hiroshima."
    m_Metadata:
      m_Items: []
  - m_Id: 27151268551065600
    m_Localized: "Nhi\u1EC1u chi\u1EBFn s\u0129 b\u1EA3o v\u1EC7 Th\xE0nh c\u1ED5
      l\xE0 sinh vi\xEAn c\xE1c tr\u01B0\u1EDDng \u0111\u1EA1i h\u1ECDc t\u1EA1i
      H\xE0 N\u1ED9i, nh\u1EEFng ng\u01B0\u1EDDi \u0111\xE3 g\xE1c b\xFAt l\xEAn
      \u0111\u01B0\u1EDDng nh\u1EADp ng\u0169 n\u0103m 1971."
    m_Metadata:
      m_Items: []
  - m_Id: 27151287404462080
    m_Localized: "S\xF4ng Th\u1EA1ch H\xE3n l\xE0 tuy\u1EBFn \u0111\u01B0\u1EDDng
      ti\u1EBFp t\u1EBF duy nh\u1EA5t. V\u01B0\u1EE3t s\xF4ng trong \u0111\xEAm d\u01B0\u1EDBi
      \xE1nh ph\xE1o s\xE1ng c\u1EE7a \u0111\u1ECBch l\xE0 m\u1ED9t nhi\u1EC7m v\u1EE5
      sinh t\u1EED."
    m_Metadata:
      m_Items: []
  - m_Id: 27151299718938624
    m_Localized: "D\xF9 ch\u1EC9 r\u1ED9ng kho\u1EA3ng 500x500 m\xE9t, Th\xE0nh c\u1ED5
      \u0111\xE3 tr\u1EDF th\xE0nh t\xE2m \u0111i\u1EC3m \u0111\u1EABm m\xE1u nh\u1EA5t
      c\u1EE7a chi\u1EBFn d\u1ECBch n\u0103m 1972."
    m_Metadata:
      m_Items: []
  - m_Id: 27151317335015424
    m_Localized: "Nh\u1EEFng c\u01A1n m\u01B0a gi\xF3 m\xF9a h\u1EA1 l\xE0m ng\u1EADp
      l\u1EE5t c\xE1c chi\u1EBFn h\xE0o, g\xE2y ra b\u1EC7nh lo\xE9t b\xE0n ch\xE2n
      v\xE0 d\u1ECBch b\u1EC7nh nghi\xEAm tr\u1ECDng cho c\xE1c chi\u1EBFn s\u0129."
    m_Metadata:
      m_Items: []
  - m_Id: 27151329687240704
    m_Localized: "V\xE0o l\xFAc cao \u0111i\u1EC3m c\u1EE7a tr\u1EADn \u0111\xE1nh,
      c\xF3 t\u1EDBi 20.000 qu\u1EA3 \u0111\u1EA1n ph\xE1o tr\xFAt xu\u1ED1ng khu
      v\u1EF1c Th\xE0nh c\u1ED5 nh\u1ECF b\xE9 m\u1ED7i ng\xE0y."
    m_Metadata:
      m_Items: []
  - m_Id: 27151341800390656
    m_Localized: "\u0110\u01B0\u1EDDng d\xE2y th\xF4ng tin li\xEAn l\u1EA1c li\xEAn
      t\u1EE5c b\u1ECB c\u1EAFt \u0111\u1EE9t do bom \u0111\u1EA1n, bu\u1ED9c c\xE1c
      chi\u1EBFn s\u0129 giao li\xEAn ph\u1EA3i ch\u1EA1y b\u1ED9 truy\u1EC1n l\u1EC7nh
      gi\u1EEFa l\xE0n h\u1ECFa l\u1EF1c d\xE0y \u0111\u1EB7c."
    m_Metadata:
      m_Items: []
  - m_Id: 27151352869158912
    m_Localized: "Khi nh\u1EEFng b\u1EE9c t\u01B0\u1EDDng th\xE0nh \u0111\u1ED5 s\u1EE5p
      th\xE0nh b\u1EE5i, c\xE1c cu\u1ED9c giao tranh th\u01B0\u1EDDng bi\u1EBFn th\xE0nh
      nh\u1EEFng tr\u1EADn \u0111\xE1nh gi\xE1p l\xE1 c\xE0 kh\u1ED1c li\u1EC7t gi\u1EEFa
      \u0111\u1ED1ng \u0111\u1ED5 n\xE1t."
    m_Metadata:
      m_Items: []
  - m_Id: 27152720317120512
    m_Localized: "B\u1EA1n c\xF3 bi\u1EBFt?"
    m_Metadata:
      m_Items: []
  - m_Id: 27152879801335808
    m_Localized: "\u0110ang ti\u1EBFn v\xE0o chi\u1EBFn tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 27153264578396160
    m_Localized: "Nh\u1EA5n \u0111\u1EC3 ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
